# 앱 서버 설정. 복사해서 .env 로 쓰고 권한을 0600 으로: cp .env.example .env && chmod 600 .env

# 필수. 워커와 공유하는 비밀 토큰 — 예: openssl rand -base64 32
VOCAB_WORKER_TOKEN=change-me

# 호스트에 노출할 포트 (기본 8000)
# VOCAB_PORT=8000

# 선택. 내부 도메인을 사설 CA(Caddy `tls internal` 등)로 HTTPS 처리할 때, 폰에 설치할 CA의
# **공개** 루트 인증서. ./data 아래 두면 컨테이너 안에서는 /data/... 경로다. 개인키는 절대 두지 말 것.
# VOCAB_CA_CERT=/data/ca.crt
# 그 인증서를 HTTPS 없이 받을 수 있는 주소 (앱 설치 안내에 표시된다)
# VOCAB_CA_URL=http://192.0.2.10:8000/ca.crt
